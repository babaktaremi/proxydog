<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProxyDog.UI.ViewModels"
        x:Class="ProxyDog.UI.Views.AboutWindow"
        x:DataType="vm:UpdateViewModel"
        Title="About ProxyDog"
        Width="380" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="28 24 28 28" Spacing="4" HorizontalAlignment="Stretch">
    <Image Source="avares://ProxyDog/Assets/AppIcon.png" Width="96" Height="96" HorizontalAlignment="Center" />
    <TextBlock Classes="title" Text="ProxyDog" HorizontalAlignment="Center" Margin="0 8 0 0" />
    <TextBlock x:Name="VersionLabel" Classes="muted" HorizontalAlignment="Center" />
    <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="290"
               HorizontalAlignment="Center" Margin="0 10 0 18"
               Text="Route any app through a SOCKS5 or HTTP proxy and watch every connection." />

    <Border Classes="group">
      <StackPanel>
        <Border Classes="row">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <TextBlock Text="GitHub" VerticalAlignment="Center" />
            <Button Grid.Column="1" x:Name="GitHubLink" Classes="plain" HorizontalAlignment="Right"
                    Click="OnGitHub" ToolTip.Tip="Open in your browser" />
          </Grid>
        </Border>
        <Border Classes="row">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <TextBlock Text="Contact" VerticalAlignment="Center" />
            <Button Grid.Column="1" x:Name="EmailLink" Classes="plain" HorizontalAlignment="Right"
                    Click="OnEmail" ToolTip.Tip="Write an email" />
          </Grid>
        </Border>
        <Border Classes="row">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Updates" />
              <TextBlock Classes="caption" Text="{Binding Status}" TextWrapping="Wrap" MaxWidth="190"
                         IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Check Now" Command="{Binding CheckNowCommand}"
                    IsEnabled="{Binding !IsChecking}" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <Border Classes="row last">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="Check automatically" VerticalAlignment="Center" />
            <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding AutoCheck}" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
