<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProxyDog.UI.ViewModels"
             x:Class="ProxyDog.UI.Views.RuleLogView"
             x:DataType="vm:RuleViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="28 8 28 28" RowSpacing="14">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel Spacing="3">
        <TextBlock Classes="title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
        <TextBlock Classes="muted" TextTrimming="CharacterEllipsis">
          <Run Text="{Binding AppName}" /><Run Text=" through " /><Run Text="{Binding Summary}" />
        </TextBlock>
        <StackPanel Orientation="Horizontal" Spacing="7" Margin="0 4 0 0">
          <Ellipse Classes="dot" Classes.on="{Binding IsActive}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding StatusText}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0 8 0 0">
          <ToggleButton Classes="switch" IsChecked="{Binding KillSwitch}" VerticalAlignment="Center"
                        ToolTip.Tip="Close the application if the proxy fails or the rule is turned off" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Kill switch" />
            <TextBlock Classes="caption" Text="Closes the application if the proxy stops responding or the rule is turned off." />
          </StackPanel>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
        <Button Content="Launch Application" Command="{Binding LaunchCommand}" IsEnabled="{Binding CanLaunch}" />
        <Button Content="Clear Log" Command="{Binding ClearLogCommand}" />
        <ToggleButton Classes="switch" IsChecked="{Binding IsOn}" Margin="6 0 0 0" ToolTip.Tip="Turn rule on or off" />
      </StackPanel>
    </Grid>

    <TextBlock Grid.Row="1" Classes="error" Text="{Binding LastError}" IsVisible="{Binding HasError}" />

    <Border Grid.Row="2" Classes="group">
      <Grid RowDefinitions="Auto,*">
        <Border Classes="hairline" Padding="14 7">
          <Grid ColumnDefinitions="68,84,206,*">
            <TextBlock Classes="caption" Text="Time" />
            <TextBlock Grid.Column="1" Classes="caption" Text="Status" />
            <TextBlock Grid.Column="2" Classes="caption" Text="Destination" />
            <TextBlock Grid.Column="3" Classes="caption">
              <TextBlock.Text>
                <MultiBinding StringFormat="Detail  ·  {0} open, {1} total">
                  <Binding Path="OpenConnections" />
                  <Binding Path="TotalConnections" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </Grid>
        </Border>

        <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Logs}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LogRowViewModel">
              <Grid ColumnDefinitions="68,84,206,*" Margin="14 0">
                <TextBlock Classes="mono muted" Text="{Binding Time}" />
                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Status}"
                           Classes.status-open="{Binding IsOpen}" Classes.status-failed="{Binding IsFailed}" />
                <TextBlock Grid.Column="2" Classes="mono" Text="{Binding Destination}" TextTrimming="CharacterEllipsis"
                           Grid.ColumnSpan="{Binding MessageSpan}" />
                <TextBlock Grid.Column="3" Classes="mono muted" Text="{Binding Detail}" TextTrimming="CharacterEllipsis"
                           Classes.status-failed="{Binding IsFailed}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" IsVisible="{Binding !HasLogs}" Margin="18 18" Spacing="4" MaxWidth="420"
                    HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
          <TextBlock Text="No Connections" FontWeight="SemiBold" />
          <TextBlock Classes="muted" TextWrapping="Wrap">
            <Run Text="Turn the rule on and use " /><Run Text="{Binding AppName}" /><Run Text=". Each connection it opens appears here with its destination and the data sent and received." />
          </TextBlock>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
