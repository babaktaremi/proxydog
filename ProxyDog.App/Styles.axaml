<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <!-- Mac-style switch: pill track, white knob that slides, accent when on. -->
    <ControlTheme x:Key="MacSwitch" TargetType="ToggleButton">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Track" CornerRadius="12" Background="{DynamicResource SwitchOffBrush}">
            <Border Name="Knob" Width="20" Height="20" CornerRadius="10" Background="White"
                    HorizontalAlignment="Left" Margin="2" BoxShadow="0 1 3 0 #40000000">
              <Border.Transitions>
                <Transitions>
                  <ThicknessTransition Property="Margin" Duration="0:0:0.2" Easing="CubicEaseOut" />
                </Transitions>
              </Border.Transitions>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked /template/ Border#Track">
        <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
      </Style>
      <Style Selector="^:checked /template/ Border#Knob">
        <Setter Property="Margin" Value="18 2 2 2" />
      </Style>
      <Style Selector="^:focus-visible /template/ Border#Track">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorLight2}" />
        <Setter Property="BorderThickness" Value="2" />
      </Style>
    </ControlTheme>
  </Styles.Resources>

  <!-- Base type: 13pt body like AppKit, system font. -->
  <Style Selector="Window">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="{DynamicResource WindowBgBrush}" />
  </Style>
  <Style Selector="Window.vibrant">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.2" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="SF Mono, Menlo, Consolas, DejaVu Sans Mono, monospace" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.status-open">
    <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
  </Style>
  <Style Selector="TextBlock.status-failed">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <!-- Status dot: hollow ring when off, filled when on. -->
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="StrokeThickness" Value="1.25" />
    <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
    <Setter Property="Fill" Value="Transparent" />
  </Style>
  <Style Selector="Ellipse.dot.on">
    <Setter Property="Stroke" Value="{DynamicResource OkBrush}" />
    <Setter Property="Fill" Value="{DynamicResource OkBrush}" />
  </Style>

  <Style Selector="Path.glyph">
    <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stretch" Value="None" />
  </Style>

  <!-- Inset grouped container, the System Settings idiom. -->
  <Style Selector="Border.group">
    <Setter Property="Background" Value="{DynamicResource GroupBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.row">
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="0 0 0 1" />
    <Setter Property="Padding" Value="14 8" />
    <Setter Property="MinHeight" Value="40" />
  </Style>
  <Style Selector="Border.row.last">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.hairline">
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="0 0 0 1" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="16 6" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <!-- Capsule buttons with a soft fill, as in Music. -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="15" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="TextElement.Foreground" Value="White" />
  </Style>
  <Style Selector="Button.plain">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
  </Style>
  <Style Selector="Button.plain:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="Button.row-main">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Button.row-main:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Pill at the foot of the sidebar -->
  <Style Selector="Button.sidebar-action">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="12 7" />
    <Setter Property="FontSize" Value="13.5" />
  </Style>

  <Style Selector="ToggleButton.switch">
    <Setter Property="Theme" Value="{StaticResource MacSwitch}" />
  </Style>

  <!-- Dropdown in the same capsule shape and soft fill as the buttons. -->
  <Style Selector="ComboBox.pill">
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="14 4 10 4" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ComboBox.pill:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
  </Style>

  <!-- Borderless form fields that sit inside a grouped row. -->
  <Style Selector="TextBox.field">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="SelectionBrush" Value="{DynamicResource SystemAccentColorLight2}" />
  </Style>
  <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement,
                   TextBox.field:focus /template/ Border#PART_BorderElement,
                   TextBox.field:focus:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Segmented control -->
  <Style Selector="ListBox.segmented">
    <Setter Property="Background" Value="{DynamicResource SegmentBgBrush}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem">
    <Setter Property="Padding" Value="14 3" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                   ListBox.segmented ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SegmentOnBrush}" />
    <Setter Property="BoxShadow" Value="0 1 2 0 #26000000" />
  </Style>

  <!-- Sidebar source list: roomy rows, soft rounded selection, accent glyphs. -->
  <Style Selector="ListBox.sidebar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem">
    <Setter Property="Padding" Value="10 0" />
    <Setter Property="Margin" Value="0 1" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="9" />
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                   ListBox.sidebar ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
  </Style>
  <Style Selector="Path.sidebar-glyph">
    <Setter Property="Stroke" Value="{DynamicResource LinkBrush}" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="Stretch" Value="None" />
  </Style>
  <Style Selector="TextBlock.sidebar-heading">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>

  <!-- A short list to choose from, inside a settings-style row. -->
  <Style Selector="ListBox.choices">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MaxHeight" Value="200" />
  </Style>
  <Style Selector="ListBox.choices ListBoxItem">
    <Setter Property="Padding" Value="10 7" />
    <Setter Property="Margin" Value="0 1" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ListBox.choices ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ListBox.choices ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="ListBox.choices ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                   ListBox.choices ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
  </Style>

  <!-- Log table -->
  <Style Selector="ListBox#LogList">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox#LogList ListBoxItem">
    <Setter Property="Padding" Value="0 3" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ListBox#LogList ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <!-- Window chrome: on macOS the title bar is transparent and the sidebar is vibrant. -->
  <Style Selector="Border.inset">
    <Setter Property="Height" Value="0" />
  </Style>
  <Style Selector="Window.vibrant Border.inset">
    <Setter Property="Height" Value="40" />
  </Style>
  <Style Selector="Border#Sidebar">
    <Setter Property="Background" Value="{DynamicResource SidebarBrush}" />
  </Style>
  <Style Selector="Window.vibrant Border#Sidebar">
    <Setter Property="Background" Value="{DynamicResource SidebarVibrantBrush}" />
  </Style>
  <Style Selector="Border#DetailPane">
    <Setter Property="Background" Value="{DynamicResource WindowBgBrush}" />
  </Style>
</Styles>
